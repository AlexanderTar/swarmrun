{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Select"]
          }
        }
      },
      "complexity": {
        "noExcessiveNestedTestSuites": "error",
        "noForEach": "error",
        "useWhile": "error"
      },
      "performance": {
        "noDelete": "error"
      },
      "style": {
        "useAsConstAssertion": "error",
        "noParameterAssign": "error",
        "noInferrableTypes": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noVar": "error"
      },
      "correctness": {
        "useJsxKeyInIterable": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "overrides": [
    {
      "includes": ["**/src/**/*.test.ts", "**/src/**/*.test.tsx", "**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/node_modules",
      "!**/out",
      "!**/src/components/ui",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
